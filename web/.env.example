# Optional. Leave empty in development (Vite forwards /api to the server on port 3001).
# For a deployed site, set this to the public address of the API server.
# Do NOT put database passwords here: everything in this file is visible in the browser.
VITE_API_URL=

# Supabase (browser-safe values only: project URL and the anon / publishable key).
# Leave both empty to keep running on the in-browser mock data. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
