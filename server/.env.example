# Copy this file to .env (same folder) and fill in the values from your FreeSQL account.
# Never commit .env and never put these values in the web app's .env.

# Connection details shown for your FreeSQL schema
ORACLE_USER=
ORACLE_PASSWORD=
# Use the same connect string that works in your test script, for example:
#   tcps://db.freesql.com:2484/your_service_name
# (A wallet is not needed when that string connects without one.)
ORACLE_CONNECT_STRING=

# Only if FreeSQL gives you a wallet (mutual TLS). Leave blank otherwise.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional: pretend today is this date (YYYY-MM-DD). Handy because the demo data covers Jan to Oct 2026.
AS_OF_DATE=
