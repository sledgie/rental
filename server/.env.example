# Copy this file to .env (same folder) and fill in the value from your Supabase project.
# Never commit .env and never put these values in the web app's .env.

# Supabase dashboard: Project Settings > Database > Connection string > URI.
# Use the "Session pooler" string (works over IPv4) or the direct connection. Replace [YOUR-PASSWORD];
# URL-encode special characters in the password (@ becomes %40, # becomes %23, and so on).
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Supabase requires SSL. Set to false only for a local Postgres without SSL.
DATABASE_SSL=true

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional: pretend today is this date (YYYY-MM-DD). Handy because the demo data covers Jan to Oct 2026.
AS_OF_DATE=
